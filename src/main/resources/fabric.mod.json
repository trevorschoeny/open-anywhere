{
  "schemaVersion": 1,
  "id": "openanywhere",
  "version": "${version}",
  "name": "Open Anywhere",
  "description": "Open shulker boxes, bundles and your ender chest right from your inventory, without placing anything. Goes with Inventory Plus.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/open-anywhere",
    "sources": "https://github.com/trevorschoeny/open-anywhere"
  },
  "license": "MIT",
  "environment": "*",
  "mixins": [
    {
      "config": "openanywhere.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "com.trevorschoeny.openanywhere.OpenAnywhere"
    ],
    "client": [
      "com.trevorschoeny.openanywhere.OpenAnywhereClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.4.0 <8.0.0",
    "slotkit": ">=2.1.0 <3.0.0"
  },
  "suggests": {
    "inventoryplus": "*"
  },
  "custom": {
    "slotkit": {
      "bothSides": "required"
    },
    "configkit": {
      "suite": "inventoryplus"
    }
  }
}
