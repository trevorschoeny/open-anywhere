{
  "schemaVersion": 1,
  "id": "openanywhere",
  "version": "${version}",
  "icon": "assets/openanywhere/icon.png",
  "name": "Open Anywhere",
  "description": "Open shulker boxes, bundles, and your ender chest from your inventory or an open chest, without placing anything. It pairs with Inventory Plus, which adds its settings menu.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/open-anywhere",
    "sources": "https://github.com/trevorschoeny/open-anywhere",
    "issues": "https://github.com/trevorschoeny/open-anywhere/issues"
  },
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "openanywhere.mixins.json",
    {
      "config": "openanywhere.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "com.trevorschoeny.openanywhere.OpenAnywhere"
    ],
    "client": [
      "com.trevorschoeny.openanywhere.OpenAnywhereClient"
    ],
    "modmenu": [
      "com.trevorschoeny.openanywhere.OpenAnywhereModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.4.0 <8.0.0",
    "slotkit": ">=2.2.0 <3.0.0",
    "keybindery": ">=1.3.0 <2.0.0"
  },
  "suggests": {
    "inventoryplus": "*"
  },
  "breaks": {
    "inventoryplus": "<3.3.0"
  },
  "custom": {
    "slotkit": {
      "bothSides": "required"
    },
    "configkit": {
      "suite": "inventoryplus"
    }
  }
}
